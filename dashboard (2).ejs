<%- include('../partials/head') %><%- include('../partials/nav') %>
<div class="app-shell"><aside class="sidebar"><a class="active" href="/admin"><i class="ti ti-layout-dashboard"></i> Overview</a><a href="/admin/books"><i class="ti ti-books"></i> Books</a><a href="/admin/students"><i class="ti ti-users"></i> Students</a><a href="/admin/reservations"><i class="ti ti-bookmark"></i> Reservations</a><a href="/admin/loans"><i class="ti ti-arrows-exchange"></i> Issue & Return</a><a href="/admin/fines"><i class="ti ti-receipt"></i> Fine Management</a></aside>
<main class="main-content"><%- include('../partials/flash') %><div class="page-heading"><div><div class="eyebrow">LIBRARY OPERATIONS</div><h1>Admin Dashboard</h1><p class="text-secondary mb-0">Monitor library activity and act on important issues.</p></div><span class="live-pill"><span></span> Connected</span></div>
<div class="stats-grid">
<div class="stat-card"><span>Total students</span><strong><%= stats.students %></strong><i class="ti ti-users"></i></div>
<div class="stat-card"><span>Book titles</span><strong><%= stats.books %></strong><i class="ti ti-books"></i></div>
<div class="stat-card"><span>Available copies</span><strong><%= stats.available %></strong><i class="ti ti-book-2"></i></div>
<div class="stat-card"><span>Active loans</span><strong><%= stats.issued %></strong><i class="ti ti-book-download"></i></div>
<div class="stat-card"><span>Pending reservations</span><strong><%= stats.reservations %></strong><i class="ti ti-bookmark"></i></div>
<div class="stat-card danger-stat"><span>Overdue loans</span><strong><%= stats.overdue %></strong><i class="ti ti-alert-triangle"></i></div>
<div class="stat-card warning-stat"><span>Unpaid fines</span><strong>₹<%= Number(stats.unpaid).toFixed(2) %></strong><i class="ti ti-currency-rupee"></i></div>
<div class="stat-card"><span>Fine collected</span><strong>₹<%= Number(stats.collected).toFixed(2) %></strong><i class="ti ti-wallet"></i></div>
</div>
<section class="panel mt-4"><div class="panel-heading"><div><h2>Priority Alert Centre</h2><p>Automatically generated from current library records</p></div><span class="badge bg-red-lt"><%= alerts.filter(a=>a.priority==='Critical' && !a.read).length %> unread critical</span></div>
<% if (!alerts.length) { %><div class="empty-inline"><i class="ti ti-circle-check"></i><div><strong>All clear</strong><p>No active alerts require attention.</p></div></div><% } %>
<div class="alert-list">
<% alerts.forEach(a => { %><article class="alert-row priority-<%= a.priority.toLowerCase() %> <%= a.read ? 'is-read' : '' %>"><div class="priority-dot"></div><div class="alert-copy"><div class="d-flex flex-wrap gap-2 align-items-center"><strong><%= a.title %></strong><span class="badge <%= a.priority==='Critical'?'bg-red-lt':a.priority==='High'?'bg-orange-lt':'bg-blue-lt' %>"><%= a.priority %></span><% if (!a.read) { %><span class="badge bg-secondary-lt">New</span><% } %></div><p><%= a.message %></p><small><%= a.createdAt.toLocaleString() %></small></div><div class="alert-actions"><% if (a.student) { %><a class="btn btn-sm btn-outline-primary" href="/admin/students">View student</a><% } %><form method="post" action="/admin/alerts/<%= a._id %>/read"><button class="btn btn-sm btn-outline-secondary">Read</button></form><form method="post" action="/admin/alerts/<%= a._id %>/resolve"><button class="btn btn-sm btn-primary">Resolve</button></form></div></article><% }) %>
</div></section>
<div class="content-grid mt-4"><section class="panel"><div class="panel-heading"><div><h2>Borrowing activity</h2><p>Monthly issued-book trend</p></div></div><canvas id="loanChart" height="180"></canvas></section><section class="panel"><div class="panel-heading"><div><h2>Quick actions</h2><p>Common library operations</p></div></div><div class="quick-actions"><a href="/admin/books"><i class="ti ti-plus"></i><span>Add or manage books</span><i class="ti ti-chevron-right"></i></a><a href="/admin/reservations"><i class="ti ti-check"></i><span>Review reservations</span><i class="ti ti-chevron-right"></i></a><a href="/admin/loans"><i class="ti ti-book-download"></i><span>Issue or return books</span><i class="ti ti-chevron-right"></i></a><a href="/admin/fines"><i class="ti ti-receipt"></i><span>Review unpaid fines</span><i class="ti ti-chevron-right"></i></a></div></section></div>
</main></div><%- include('../partials/footer') %>
