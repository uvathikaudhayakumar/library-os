<%- include('../partials/head') %><%- include('../partials/nav') %><div class="app-shell"><aside class="sidebar"><a class="active" href="/student"><i class="ti ti-layout-dashboard"></i> My Dashboard</a><a href="/student/books"><i class="ti ti-books"></i> Explore Books</a></aside><main class="main-content"><%- include('../partials/flash') %><div class="page-heading"><div><div class="eyebrow">STUDENT PORTAL</div><h1>Welcome, <%= student.name %></h1><p class="text-secondary"><%= student.registrationNo || student.email %> · <%= student.department || 'Student' %></p></div><a class="btn btn-primary" href="/student/books"><i class="ti ti-search"></i> Explore catalogue</a></div><div class="stats-grid student-stats"><div class="stat-card"><span>Active loans</span><strong><%= loans.filter(l=>l.status!=='Returned').length %></strong><i class="ti ti-book"></i></div><div class="stat-card"><span>Reservations</span><strong><%= reservations.filter(r=>['Pending','Approved'].includes(r.status)).length %></strong><i class="ti ti-bookmark"></i></div><div class="stat-card warning-stat"><span>Unpaid fines</span><strong>₹<%= fines.reduce((s,f)=>s+f.amount,0).toFixed(2) %></strong><i class="ti ti-receipt"></i></div></div><div class="content-grid mt-4"><section class="panel"><div class="panel-heading"><div><h2>My borrowed books</h2><p>Track due dates and request returns.</p></div></div><div class="table-responsive"><table class="table"><thead><tr><th>Book</th><th>Due date</th><th>Status</th><th>Action</th></tr></thead><tbody><% loans.forEach(l=>{ %><tr><td><%= l.book?.title || '—' %></td><td><%= l.dueAt.toLocaleDateString() %></td><td><span class="badge <%= l.status==='Returned'?'bg-green-lt':'bg-blue-lt' %>"><%= l.status %></span></td><td><% if(l.status==='Issued'){ %><form method="post" action="/student/return-request/<%= l._id %>"><button class="btn btn-sm btn-outline-primary">Request return</button></form><% } %></td></tr><% }) %></tbody></table></div></section><section class="panel"><div class="panel-heading"><div><h2>My reservations</h2><p>Latest reservation activity.</p></div></div><% reservations.forEach(r=>{ %><div class="mini-record"><div><strong><%= r.book?.title || 'Book' %></strong><small><%= r.createdAt.toLocaleDateString() %></small></div><span class="badge bg-blue-lt"><%= r.status %></span></div><% }) %></section></div><section class="panel mt-4"><div class="panel-heading"><div><h2>Notifications</h2><p>Updates from your library.</p></div></div><% if(!notifications.length){ %><p class="text-secondary">No notifications yet.</p><% } %><% notifications.forEach(n=>{ %><div class="mini-record"><div><strong><%= n.title %></strong><small><%= n.message %> · <%= n.createdAt.toLocaleString() %></small></div><% if(!n.read){ %><span class="badge bg-blue-lt">New</span><% } %></div><% }) %></section></main></div><%- include('../partials/footer') %>
