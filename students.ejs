<%- include('../partials/head') %><%- include('../partials/nav') %><div class="app-shell"><aside class="sidebar"><a href="/admin">Overview</a><a href="/admin/books">Books</a><a class="active" href="/admin/students">Students</a><a href="/admin/reservations">Reservations</a><a href="/admin/loans">Issue & Return</a><a href="/admin/fines">Fine Management</a></aside><main class="main-content"><div class="page-heading"><div><div class="eyebrow">PEOPLE</div><h1>Student Directory</h1><p class="text-secondary">Student accounts and registration details.</p></div></div><section class="panel"><div class="panel-heading"><h2>Registered students</h2><input class="form-control table-search" placeholder="Search students..." data-table-search="#studentsTable"></div><div class="table-responsive"><table class="table" id="studentsTable"><thead><tr><th>Name</th><th>Registration no.</th><th>Email</th><th>Department</th><th>Year</th><th>Status</th></tr></thead><tbody><% students.forEach(s=>{ %><tr><td class="fw-semibold"><%= s.name %></td><td><%= s.registrationNo || '—' %></td><td><%= s.email %></td><td><%= s.department || '—' %></td><td><%= s.year || '—' %></td><td><span class="badge <%= s.active?'bg-green-lt':'bg-secondary-lt' %>"><%= s.active?'Active':'Inactive' %></span></td></tr><% }) %></tbody></table></div></section></main></div><%- include('../partials/footer') %>
