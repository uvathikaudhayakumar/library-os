<%- include('../partials/head') %><%- include('../partials/nav') %><div class="app-shell"><aside class="sidebar"><a href="/admin">Overview</a><a href="/admin/books">Books</a><a href="/admin/students">Students</a><a href="/admin/reservations">Reservations</a><a class="active" href="/admin/loans">Issue & Return</a><a href="/admin/fines">Fine Management</a></aside><main class="main-content"><%- include('../partials/flash') %><div class="page-heading"><div><div class="eyebrow">CIRCULATION</div><h1>Issue & Return</h1><p class="text-secondary">Issue books and confirm student return requests.</p></div></div><section class="panel mb-4"><div class="panel-heading"><h2>Issue a book</h2></div><form method="post" action="/admin/loans/issue" class="row g-3"><div class="col-md-5"><label class="form-label">Student</label><select class="form-select" name="student" required><option value="">Select student</option><% students.forEach(s=>{ %><option value="<%= s._id %>"><%= s.registrationNo || s.email %> — <%= s.name %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">Book</label><select class="form-select" name="book" required><option value="">Select available book</option><% books.forEach(b=>{ %><option value="<%= b._id %>"><%= b.title %> (available: <%= b.availableCopies %>)</option><% }) %></select></div><div class="col-md-2"><label class="form-label">Due date</label><input class="form-control" type="date" name="dueAt" required></div><div class="col-md-1 d-flex align-items-end"><button class="btn btn-primary">Issue</button></div></form></section><section class="panel"><div class="panel-heading"><h2>Loan records</h2></div><div class="table-responsive"><table class="table"><thead><tr><th>Student</th><th>Book</th><th>Issued</th><th>Due</th><th>Status</th><th>Action</th></tr></thead><tbody><% loans.forEach(l=>{ %><tr><td><%= l.student?.name || '—' %></td><td><%= l.book?.title || '—' %></td><td><%= l.issuedAt.toLocaleDateString() %></td><td><%= l.dueAt.toLocaleDateString() %></td><td><span class="badge <%= l.status==='Returned'?'bg-green-lt':l.status==='Return Requested'?'bg-orange-lt':'bg-blue-lt' %>"><%= l.status %></span></td><td><% if(l.status!=='Returned'){ %><form method="post" action="/admin/loans/<%= l._id %>/return" class="return-form"><button class="btn btn-sm btn-primary">Confirm return</button></form><% } %></td></tr><% }) %></tbody></table></div></section></main></div><%- include('../partials/footer') %>
