<%- include('../partials/head') %><%- include('../partials/nav') %><div class="app-shell"><aside class="sidebar"><a href="/student">My Dashboard</a><a class="active" href="/student/books">Explore Books</a></aside><main class="main-content"><%- include('../partials/flash') %><div class="page-heading"><div><div class="eyebrow">DISCOVER</div><h1>Book Catalogue</h1><p class="text-secondary">Search the collection and request a reservation.</p></div></div><form class="search-bar mb-4" method="get"><i class="ti ti-search"></i><input class="form-control" name="q" value="<%= query %>" placeholder="Search title, author, ISBN or category"><button class="btn btn-primary">Search</button></form><div class="book-grid"><% books.forEach(b=>{ %><article class="book-card"><div class="book-cover"><% if(b.coverUrl){ %><img src="<%= b.coverUrl %>" alt="Cover of <%= b.title %>"><% } else { %><i class="ti ti-book-2"></i><% } %></div><div class="book-info"><span class="eyebrow"><%= b.category %></span><h3><%= b.title %></h3><p><%= b.author %></p><div class="d-flex justify-content-between align-items-center"><span class="small <%= b.availableCopies?'text-success':'text-danger' %>"><%= b.availableCopies %> available</span><% if(b.availableCopies>0){ %><form method="post" action="/student/reserve/<%= b._id %>"><button class="btn btn-sm btn-primary">Reserve</button></form><% } else { %><button class="btn btn-sm btn-secondary" disabled>Unavailable</button><% } %></div></div></article><% }) %></div></main></div><%- include('../partials/footer') %>
