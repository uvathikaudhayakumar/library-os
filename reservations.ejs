<%- include('../partials/head') %><%- include('../partials/nav') %><div class="app-shell"><aside class="sidebar"><a href="/admin">Overview</a><a href="/admin/books">Books</a><a href="/admin/students">Students</a><a class="active" href="/admin/reservations">Reservations</a><a href="/admin/loans">Issue & Return</a><a href="/admin/fines">Fine Management</a></aside><main class="main-content"><%- include('../partials/flash') %><div class="page-heading"><div><div class="eyebrow">REQUESTS</div><h1>Reservation Management</h1><p class="text-secondary">Review and process student book requests.</p></div></div><section class="panel"><div class="table-responsive"><table class="table"><thead><tr><th>Student</th><th>Registration</th><th>Book</th><th>Requested</th><th>Status</th><th>Actions</th></tr></thead><tbody><% reservations.forEach(r=>{ %><tr><td><%= r.student?.name || 'Deleted student' %></td><td><%= r.student?.registrationNo || '—' %></td><td><%= r.book?.title || 'Deleted book' %></td><td><%= r.createdAt.toLocaleDateString() %></td><td><span class="badge bg-blue-lt"><%= r.status %></span></td><td><% if(r.status==='Pending'){ %><div class="d-flex gap-2"><form method="post" action="/admin/reservations/<%= r._id %>/approve"><button class="btn btn-sm btn-primary">Approve</button></form><form method="post" action="/admin/reservations/<%= r._id %>/reject"><button class="btn btn-sm btn-outline-danger">Reject</button></form></div><% } %></td></tr><% }) %></tbody></table></div></section></main></div><%- include('../partials/footer') %>
