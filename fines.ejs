<%- include('../partials/head') %><%- include('../partials/nav') %><div class="app-shell"><aside class="sidebar"><a href="/admin">Overview</a><a href="/admin/books">Books</a><a href="/admin/students">Students</a><a href="/admin/reservations">Reservations</a><a href="/admin/loans">Issue & Return</a><a class="active" href="/admin/fines">Fine Management</a></aside><main class="main-content"><%- include('../partials/flash') %><div class="page-heading"><div><div class="eyebrow">PAYMENTS</div><h1>Fine Management</h1><p class="text-secondary">Review outstanding fines and record confirmed payments.</p></div></div><section class="panel"><div class="table-responsive"><table class="table"><thead><tr><th>Student</th><th>Registration</th><th>Loan</th><th>Overdue days</th><th>Amount</th><th>Status</th><th>Action</th></tr></thead><tbody><% fines.forEach(f=>{ %><tr><td><%= f.student?.name || '—' %></td><td><%= f.student?.registrationNo || '—' %></td><td><%= f.loan?._id || '—' %></td><td><%= f.overdueDays %></td><td class="fw-bold">₹<%= Number(f.amount).toFixed(2) %></td><td><span class="badge <%= f.status==='Paid'?'bg-green-lt':'bg-red-lt' %>"><%= f.status %></span></td><td><% if(f.status==='Unpaid'){ %><form method="post" action="/admin/fines/<%= f._id %>/paid" class="payment-form d-flex gap-2"><input class="form-control form-control-sm" name="reference" placeholder="Receipt/reference" aria-label="Payment reference"><button class="btn btn-sm btn-primary">Confirm paid</button></form><% } else { %><small><%= f.paidAt?.toLocaleDateString() || '' %></small><% } %></td></tr><% }) %></tbody></table></div></section></main></div><%- include('../partials/footer') %>
