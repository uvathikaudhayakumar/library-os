<%- include('../partials/head') %><%- include('../partials/nav') %><div class="app-shell"><aside class="sidebar"><a href="/admin">Overview</a><a class="active" href="/admin/books">Books</a><a href="/admin/students">Students</a><a href="/admin/reservations">Reservations</a><a href="/admin/loans">Issue & Return</a><a href="/admin/fines">Fine Management</a></aside><main class="main-content"><%- include('../partials/flash') %><div class="page-heading"><div><div class="eyebrow">CATALOGUE</div><h1>Book Management</h1><p class="text-secondary">Maintain titles, categories and available copies.</p></div></div>
<section class="panel mb-4"><div class="panel-heading"><h2>Add a book</h2></div><form method="post" action="/admin/books" class="row g-3"><div class="col-md-4"><label class="form-label">Book title</label><input class="form-control" name="title" required></div><div class="col-md-3"><label class="form-label">Author</label><input class="form-control" name="author" required></div><div class="col-md-2"><label class="form-label">ISBN</label><input class="form-control" name="isbn"></div><div class="col-md-3"><label class="form-label">Category</label><input class="form-control" name="category"></div><div class="col-md-2"><label class="form-label">Total copies</label><input class="form-control" type="number" min="0" name="totalCopies" value="1" required></div><div class="col-md-8"><label class="form-label">Cover image URL (optional)</label><input class="form-control" name="coverUrl"></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">Add book</button></div></form></section>
<section class="panel"><div class="panel-heading"><h2>Library catalogue</h2><input class="form-control table-search" placeholder="Search books..." data-table-search="#booksTable"></div><div class="table-responsive"><table class="table table-vcenter" id="booksTable"><thead><tr><th>Title</th><th>Author</th><th>Category</th><th>ISBN</th><th>Available</th><th>Total</th><th></th></tr></thead><tbody><% books.forEach(b=>{ %><tr><td class="fw-semibold"><%= b.title %></td><td><%= b.author %></td><td><%= b.category %></td><td><%= b.isbn || '—' %></td><td><span class="badge <%= b.availableCopies===0?'bg-red-lt':'bg-green-lt' %>"><%= b.availableCopies %></span></td><td><%= b.totalCopies %></td><td><form method="post" action="/admin/books/<%= b._id %>/delete" class="delete-form"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr><% }) %></tbody></table></div></section></main></div><%- include('../partials/footer') %>
